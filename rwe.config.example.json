{
  "bind": "127.0.0.1",
  "port": 8787,
  "workRoot": "/var/lib/remote-workflow-engine",
  "timeoutMs": 15000,
  "retries": 1,
  "maxWorkflowDepth": 4,
  "maxWorkflowDescendants": 256,
  "maxConcurrentRuns": 64,
  "workspaceTtlMs": 0,
  "maxTimeoutMs": 600000,
  "maxAppendPromptBytes": 1024,
  "maxEffort": "high",
  "gateway": "sdk",
  "seedRefAllowlist": [],
  "maxBlobBytes": 268435456,
  "modelProbe": {
    "enabled": true,
    "intervalMs": 604800000,
    "timeoutMs": 60000
  },
  "defaultAllowedTools": [
    "Read",
    "Write",
    "Edit",
    "Glob",
    "Grep",
    "Bash"
  ],
  "auth": {
    "enabled": false,
    "googleClientId": "<your Google Cloud Console OAuth 2.0 client ID>",
    "googleClientSecret": "<your Google OAuth 2.0 client secret>"
  },
  "principals": {
    "alice@example.com": { "role": "admin" }
  },
  "mcpEgressAllowlist": [
    "https://api.example.com"
  ],
  "sandbox": {
    "allowHostPaths": []
  }
}
