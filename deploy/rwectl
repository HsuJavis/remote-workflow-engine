#!/usr/bin/env bash
# deploy/rwectl — day-2 control of an engine that runs as a dedicated service user (default `rwe`,
# see deploy/migrate-to-service-user.sh and DEPLOY.md「以獨立系統使用者執行（建議）」).
# The service user has no login session, so its systemd --user instance is reached by pointing
# systemctl at its runtime dir + bus explicitly. Run as the operator (uses sudo).
#
#   rwectl status                 # = systemctl --user status rwe.service (as rwe); restart/status/
#   rwectl restart                #   stop/start/is-active/enable/disable default the unit to
#   rwectl restart rwe.service    #   rwe.service when none is given; any other systemctl verb or an
#   rwectl list-timers            #   explicit unit passes straight through: list-timers/daemon-reload/
#                                 #   cat rwe.service/...
#   rwectl logs [-f] [-n 200]     # journal of rwe.service (extra args go to journalctl)
#   rwectl logs-update [-n 50]    # journal of rwe-update.service (self-update runs)
#   rwectl update-result          # the last self-update outcome (result.json)
#
# RWE_USER overrides the account name.
set -euo pipefail
RWE_USER="${RWE_USER:-rwe}"
case "${1:-}" in ""|-h|--help) sed -n '2,16p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;; esac
uid="$(id -u "$RWE_USER" 2>/dev/null)" || { echo "rwectl: no such user '$RWE_USER'" >&2; exit 1; }
home="$(getent passwd "$RWE_USER" | cut -d: -f6)"
cd /   # sudo -u keeps the cwd; the operator's home is unreadable to the service user

journal() {  # journal UNIT [journalctl args...] — lines the unit's processes wrote + manager events
  local unit="$1"; shift
  exec sudo journalctl --no-pager _UID="$uid" _SYSTEMD_USER_UNIT="$unit" + _UID="$uid" USER_UNIT="$unit" "$@"
}

case "${1:-}" in
  logs) shift; journal rwe.service "$@" ;;
  logs-update) shift; journal rwe-update.service "$@" ;;
  update-result) exec sudo cat "$home/.local/share/rwe-update/result.json" ;;
  restart|status|stop|start|is-active|enable|disable)
    # These verbs take exactly one unit; systemctl errors ("Too few arguments.") if none is given.
    # Default to rwe.service so `rwectl restart` works the same as `rwectl restart rwe.service`;
    # a unit that IS given (or any extra args) is passed through unchanged.
    if [ "$#" -eq 1 ]; then set -- "$1" rwe.service; fi
    exec sudo -u "$RWE_USER" env XDG_RUNTIME_DIR="/run/user/$uid" \
      DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" systemctl --user "$@"
    ;;
  *) exec sudo -u "$RWE_USER" env XDG_RUNTIME_DIR="/run/user/$uid" \
       DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" systemctl --user "$@" ;;
esac
